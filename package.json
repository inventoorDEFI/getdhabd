{
  "name": "dhabt",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-submission compliance checker for Saudi building permit applications",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --distdir .next-build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify-guards": "tsx scripts/verify-guards.ts",
    "codes:load": "tsx scripts/load-code-pack.ts",
    "codes:verify": "tsx scripts/verify-clause.ts",
    "codes:status": "tsx scripts/code-status.ts"
  },
  "dependencies": {
    "next": "^15.5.26",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
