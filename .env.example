# Postgres 15 or newer (the schema uses UNIQUE NULLS NOT DISTINCT)
# with pgvector 0.5.0 or newer
DATABASE_URL=postgresql://localhost:5432/dhabt

# Set to "1" only in local development. Allows code documents marked as
# fixtures to produce findings. Never set this in staging or production.
DHABT_ALLOW_FIXTURE_CODES=0
